# Copy this file to srcs/.env and adjust the values.

DOMAIN_NAME=login.42.fr

DB_NAME=wordpress
DB_USER=wpuser

WP_TITLE=Inception
# WP_ADMIN_USER must NOT contain "admin" or "administrator" (case-insensitive).
WP_ADMIN_USER=example_user
WP_ADMIN_EMAIL=example_user@example.com

WP_USER=example_user2
WP_USER_EMAIL=example_user2@example.com

# Keep the canonical URL without the VirtualBox forwarding port (for example, do NOT add :8443).
WP_URL=https://login.42.fr
